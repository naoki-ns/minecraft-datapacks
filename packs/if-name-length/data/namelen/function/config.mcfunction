#=============================================================================
#  文字数が力 / Name Length Is Power
#  ★ 調整するのはこのファイルだけ ★
#  編集したら:  /reload  ->  /function namelen:config
#=============================================================================

# --- 攻撃力の倍率 ------------------------------------------------------------
#  攻撃力 = 文字数 × 文字数 × #mult
#  1 のとき:  土(1文字)=1 / ネザライトの剣(7文字)=49 / ダイヤモンドの剣(8文字)=64
#  撮影で派手にしたいときは preset/movie（= 3）を使う。
scoreboard players set #mult namelen.cfg 1

# --- 攻撃力の下限・上限 ------------------------------------------------------
#  #cap は attack_damage 属性の上限（2048）に合わせてある。
#  エンダードラゴンは体力 200 なので、14文字以上あればワンパンできる。
scoreboard players set #min namelen.cfg 1
scoreboard players set #cap namelen.cfg 2048

# --- 未登録アイテムの文字数 --------------------------------------------------
#  table.mcfunction に載っていない物を持ったときの文字数。0 なら最弱扱い。
scoreboard players set #default namelen.cfg 0

# --- 更新間隔（tick）---------------------------------------------------------
#  手持ちを見て攻撃力を計算し直す間隔。20 = 1秒。持ち替えの反応速度に直結する。
scoreboard players set #interval namelen.cfg 2

# --- カスタムネームの補正値 --------------------------------------------------
#  金床で付けた名前の文字数は NBT から直接取っている。
#  バージョンによっては余分な文字（JSON の飾り）が混ざって多めに出ることがある。
#  ズレていたら /function namelen:debug/probe で実測して、その差をここに入れる。
scoreboard players set #name_overhead namelen.cfg 0

# --- アクションバー表示（1=出す / 0=出さない）--------------------------------
#  「◯文字 → 攻撃力 ◯」を常時表示する。動画では出しておくと説明が要らない。
scoreboard players set #actionbar namelen.cfg 1

# --- 殴ったときの演出（1=出す / 0=出さない）----------------------------------
#  攻撃力（文字数の2乗×倍率）が高いほど派手になる。段階は internal/fx.mcfunction。
scoreboard players set #fx namelen.cfg 1
